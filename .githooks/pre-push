#!/usr/bin/env bash
# Pre-push hook: the full local gate set plus the vendored queue and link
# validators, against the working tree. Installed by scripts/setup.sh. See
# docs/QUALITY.md.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

bash scripts/check.sh
bash docket/scripts/check-queues.sh --strict
bash docket/scripts/check-links.sh
